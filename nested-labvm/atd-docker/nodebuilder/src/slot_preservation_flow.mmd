---
title: Nodebuilder Orphaned Port Slot Preservation Flow
---
flowchart TD
    %% =====================================================================
    %% DELETE DEVICE PATH
    %% =====================================================================
    subgraph DEL["Delete Device (resource_manager.py)"]
        D1[delete_node_completely\nor cleanup_connection]
        D2{ENABLE_SLOT_PRESERVATION?}
        D3[Record orphaned slot\nrecord_orphaned_slot\norphaned_interfaces.py]
        D4[Keep OVS bridge alive\nskip_bridges set]
        D5[Detach interface\nfrom target VM]
        D6[Delete OVS bridge]
    end

    %% =====================================================================
    %% STARTUP RECONCILIATION PATH
    %% =====================================================================
    subgraph START["Startup Reconciliation (orphaned_interfaces.py)"]
        S1[cleanup_stale_orphaned_interfaces]
        S2{Interface bridge\nexists in OVS?}
        S3{MAC in orphaned\nslot registry?}
        S4[Recreate missing bridge\ncreate_ovs_bridge]
        S5[Detach stale interface\ndetach_interface_from_vm]
        S6[Start VM if shut off\nvirsh start]
    end

    %% =====================================================================
    %% REUSE SLOT PATH
    %% =====================================================================
    subgraph REUSE["Create Connection / Reuse Slot"]
        R1[create_connection\nconnection_manager.py\nor attach_interface_with_slot_reuse\nslot_reuse.py]
        R2{Orphaned slot\nexists for target port?}
        R3[update_interface_bridge\nswap bridge on existing MAC\nno VM reboot needed]
        R4[claim_orphaned_slot\nremove from registry]
        R5[Delete old bridge\nthat was kept alive]
        R6[Attach new interface\nVM reboot needed]
    end

    %% =====================================================================
    %% PERSISTENCE
    %% =====================================================================
    subgraph PERSIST["Persistence (orphaned_interfaces.yaml)"]
        P1[(orphaned_interfaces.yaml\ndevice → slot_number\nmac_address\nold_bridge\norphaned_at)]
    end

    %% =====================================================================
    %% CONFIG
    %% =====================================================================
    CFG[config.py\nENABLE_SLOT_PRESERVATION=true]

    %% =====================================================================
    %% EDGES - DELETE PATH
    %% =====================================================================
    D1 --> D2
    D2 -->|Yes| D3
    D3 --> P1
    D3 --> D4
    D2 -->|No| D5
    D5 --> D6
    D4 -.->|bridge kept for VM boot| PERSIST

    %% =====================================================================
    %% EDGES - STARTUP PATH
    %% =====================================================================
    S1 --> S2
    S2 -->|missing| S3
    S3 -->|Yes - recorded slot| S4
    S4 --> S6
    S3 -->|No - stale| S5
    S5 --> S6
    S1 -.->|reads| P1

    %% =====================================================================
    %% EDGES - REUSE PATH
    %% =====================================================================
    R1 --> R2
    R2 -->|Yes| R3
    R3 --> R4
    R4 --> P1
    R4 --> R5
    R2 -->|No| R6
    R1 -.->|reads| P1

    %% =====================================================================
    %% CONFIG WIRES
    %% =====================================================================
    CFG -->|gates all paths| D2
    CFG -->|gates reuse check| R2
