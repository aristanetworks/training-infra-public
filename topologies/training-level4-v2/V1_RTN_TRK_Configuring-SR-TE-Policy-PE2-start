!
hostname PE2
!
ip routing
mpls ip
!
service routing protocols model multi-agent
!
router traffic-engineering
   router-id ipv4 192.168.100.2
!
router isis isis
   net 49.0000.0000.0000.0002.00
   router-id ipv4 192.168.100.2
   is-type level-1
   address-family ipv4 unicast
      segment-routing mpls
         no shutdown
   traffic-engineering
      is-type level-1
      no shutdown
!
interface Loopback0
   ip address 192.168.100.2/32
   isis enable isis
   node-segment ipv4 index 2
!
interface Ethernet1
   no switchport
   ip address 192.168.12.1/30
   mtu 1500
   no shutdown
!
interface Ethernet2
   no switchport
   ip address 192.168.22.1/30
   mtu 1500
   no shutdown
!
interface Ethernet3
   no switchport
   ip address 192.168.32.1/30
   mtu 1500
   no shutdown
!
interface Ethernet4
   no switchport
   ip address 172.16.23.2/24
   mtu 1500
   isis enable isis
   isis network point-to-point
   traffic-engineering
   no shutdown
!
interface Ethernet5
   no switchport
   ip address 172.16.24.2/24
   mtu 1500
   isis enable isis
   isis network point-to-point
   traffic-engineering
   no shutdown
!
interface Ethernet6
   no switchport
   ip address 172.16.26.2/24
   mtu 1500
   isis enable isis
   isis network point-to-point
   traffic-engineering
   no shutdown
!
