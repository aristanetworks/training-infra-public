ip routing
mpls ip
!
service routing protocols model multi-agent
!
router isis isis
net 49.0000.0000.0000.0003.00
router-id ipv4 192.168.100.3

is-type level-1
!
address-family ipv4 unicast
segment-routing mpls
shutdown
!
interface Loopback0
ip address 192.168.100.3/32
isis enable isis
node-segment ipv4 index 3
!
interface Ethernet1
no switchport
ip address 172.16.13.3/24
mtu 1500
isis enable isis
isis network point-to-point
no shutdown
!
interface Ethernet2
no switchport
ip address 172.16.23.3/24
mtu 1500
isis enable isis
isis network point-to-point
no shutdown
!
ip prefix-list ldp-fec-prefix-list
permit 192.168.100.0/24 ge 24
!
mpls ldp
router-id interface Loopback0 force
fec filter prefix-list ldp-fec-prefix-list
no shutdown
