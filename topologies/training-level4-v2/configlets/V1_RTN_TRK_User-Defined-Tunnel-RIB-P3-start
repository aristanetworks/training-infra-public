!
hostname P3
!
ip routing
!
mpls ip
!
interface Ethernet1
   no switchport
   ip address 172.16.13.3/24
   isis enable isis
   isis network point-to-point
   mpls ldp interface
!
interface Ethernet2
   no switchport
   ip address 172.16.23.3/24
   isis enable isis
   isis network point-to-point
   mpls ldp interface
!
interface Loopback0
   ip address 192.168.100.3/32
   isis enable isis
!
router isis isis
   net 49.0001.0000.0000.0003.00
   is-type level-1
   router-id ipv4 192.168.100.3
   !
   address-family ipv4 unicast
      segment-routing mpls
      shutdown
!
mpls ldp
   router-id 192.168.100.3
   no shutdown
   transport-address interface Loopback0
!