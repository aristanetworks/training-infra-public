hostname PE1
!
ip routing
!
service routing protocols model multi-agent
!
mpls ip
!
ip prefix-list ldp-fec-prefix-list
   seq 10 permit 192.168.100.0/24 ge 24
!
mpls ldp
   router-id interface Loopback0
   fec filter prefix-list ldp-fec-prefix-list
   no shutdown
!
mpls rsvp
   fast-reroute mode node-protection
   no shutdown
!
vrf instance B
!
ip routing vrf B
!
router isis isis
   net 49.0000.0000.0000.0001.00
   router-id ipv4 192.168.100.1
   is-type level-1
   address-family ipv4 unicast
   traffic-engineering
      no shutdown
!
router traffic-engineering
   rsvp
      local-interface Loopback0
      !
      path Path-to-PE2-Dynamic dynamic
      !
      path Dynamic-P5-loose-path dynamic
         hop 192.168.100.5 loose
      !
      tunnel Tunnel-1-to-PE2
         destination ip 192.168.100.2
         path Path-to-PE2-Dynamic
         bandwidth 30.00 mbps
         igp shortcut
         optimization interval 2 seconds
         no shutdown
      !
      tunnel Tunnel-2-to-PE2
         destination ip 192.168.100.2
         path Dynamic-P5-loose-path
         bandwidth 40.00 mbps
         igp shortcut
         optimization interval 2 seconds
         no shutdown
!
router bgp 100
   neighbor 192.168.100.2 remote-as 100
   neighbor 192.168.100.2 update-source Loopback0
   neighbor 192.168.100.2 send-community extended
   !
   address-family vpn-ipv4
      neighbor 192.168.100.2 activate
   !
   vrf B
      rd 100:2
      route-target import vpn-ipv4 100:2
      route-target export vpn-ipv4 100:2
      neighbor 192.168.21.2 remote-as 65102
!
interface Ethernet1
   no switchport
   ip address 192.168.11.1/30
   no shutdown
!
interface Ethernet2
   no switchport
   vrf B
   ip address 192.168.21.1/30
   no shutdown
!
interface Ethernet3
   no switchport
   ip address 192.168.31.1/30
   no shutdown
!
interface Ethernet4
   no switchport
   ip address 172.16.13.1/24
   isis enable isis
   isis network point-to-point
   traffic-engineering
   traffic-engineering bandwidth 75 percent
   no shutdown
!
interface Ethernet5
   no switchport
   ip address 172.16.14.1/24
   isis enable isis
   isis network point-to-point
   traffic-engineering
   traffic-engineering bandwidth 75 percent
   no shutdown
!
interface Ethernet6
   no switchport
   ip address 172.16.15.1/24
   isis enable isis
   isis network point-to-point
   traffic-engineering
   traffic-engineering bandwidth 75 percent
   no shutdown
!
interface Loopback0
   ip address 192.168.100.1/32
   isis enable isis
!