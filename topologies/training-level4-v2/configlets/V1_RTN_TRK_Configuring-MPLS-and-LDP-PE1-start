hostname PE1
ip routing

interface Ethernet1
   description TO-A1
   no switchport
   ip address 192.168.11.1/30

interface Ethernet2
   description TO-B1
   no switchport
   ip address 192.168.21.1/30

interface Ethernet3
   description TO-C1
   no switchport
   ip address 192.168.31.1/30

interface Ethernet4
   description TO-P3
   no switchport
   ip address 172.16.13.1/24
   isis enable isis
   isis network point-to-point

interface Ethernet5
   description TO-P4
   no switchport
   ip address 172.16.14.1/24
   isis enable isis
   isis network point-to-point

interface Ethernet6
   description TO-P5
   no switchport
   ip address 172.16.15.1/24
   isis enable isis
   isis network point-to-point

interface Loopback0
   ip address 192.168.100.1/32
   isis enable isis

router isis isis
   net 49.0000.0000.0000.0001.00
   router-id ipv4 192.168.100.1
   is-type level-1
   address-family ipv4 unicast