hostname PE2
!
vrf instance B
!
interface Ethernet1
   no switchport
   ip address 192.168.12.1/30
!
interface Ethernet2
   no switchport
   ip address 192.168.22.1/30
!
interface Ethernet3
   no switchport
   ip address 192.168.32.1/30
!
interface Ethernet4
   no switchport
   ip address 172.16.23.2/24
   isis enable isis
   isis network point-to-point
!
interface Ethernet5
   no switchport
   ip address 172.16.24.2/24
   isis enable isis
   isis network point-to-point
!
interface Ethernet6
   no switchport
   ip address 172.16.26.2/24
   isis enable isis
   isis network point-to-point
!
interface Loopback0
   ip address 192.168.100.2/32
   isis enable isis
!
ip routing
ip routing vrf B
!
router isis isis
   net 49.0000.0000.0000.0002.00
   router-id ipv4 192.168.100.2
   is-type level-1
   !
   address-family ipv4 unicast
!