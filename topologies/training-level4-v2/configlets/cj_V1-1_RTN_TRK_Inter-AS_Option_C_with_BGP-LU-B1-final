hostname B1
!
service routing protocols model multi-agent
!
ip routing
!
interface Ethernet1
   no switchport
   ip address 192.168.21.2/30
!
interface Loopback0
   ip address 192.168.20.1/32
!
router bgp 65200
   router-id 192.168.20.1
   neighbor 192.168.21.1 remote-as 100
   network 192.168.20.1/32
