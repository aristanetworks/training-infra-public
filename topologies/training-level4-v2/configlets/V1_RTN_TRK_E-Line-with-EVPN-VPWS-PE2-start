!
hostname PE2
!
ip routing
mpls ip
!
service routing protocols model multi-agent
!
router isis isis
   net 49.0000.0000.0000.0002.00
   router-id ipv4 192.168.100.2
   is-type level-1
   address-family ipv4 unicast
      segment-routing mpls
         no shutdown
!
interface Loopback0
   ip address 192.168.100.2/32
   isis enable isis
   node-segment ipv4 index 2
!
interface Ethernet1
   no switchport
   ip address 192.168.12.1/30
   no shutdown
!
interface Ethernet2
   no switchport
   no ip address
   no shutdown
!
interface Ethernet3
   no switchport
   no ip address
   no shutdown
!
interface Ethernet4
   no switchport
   ip address 172.16.23.2/24
   isis enable isis
   isis network point-to-point
   no shutdown
!
interface Ethernet5
   no switchport
   ip address 172.16.24.2/24
   isis enable isis
   isis network point-to-point
   no shutdown
!
interface Ethernet6
   no switchport
   ip address 172.16.26.2/24
   isis enable isis
   isis network point-to-point
   no shutdown
!
router bgp 65100
   router-id 192.168.100.2
   neighbor 192.168.100.1 remote-as 65100
   neighbor 192.168.100.1 update-source Loopback0
!
