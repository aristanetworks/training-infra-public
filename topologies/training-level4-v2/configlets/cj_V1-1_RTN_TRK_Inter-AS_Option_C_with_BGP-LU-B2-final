hostname B2
!
service routing protocols model multi-agent
!
ip routing
!
interface Ethernet1
   no switchport
   ip address 192.168.22.2/30
!
interface Loopback0
   ip address 192.168.20.2/32
!
router bgp 65220
   router-id 192.168.20.2
   neighbor 192.168.22.1 remote-as 200
   network 192.168.20.2/32
