hostname A2
!
ip routing
ip route 0.0.0.0/0 192.168.12.1
!
interface Ethernet1
   no switchport
   ip address 192.168.12.2/30
   no shutdown
!
interface Loopback0
   ip address 192.168.2.1/32
!
router bgp 65201
   router-id 192.168.2.1
   neighbor 192.168.12.1 remote-as 100
   network 192.168.2.1/32
!