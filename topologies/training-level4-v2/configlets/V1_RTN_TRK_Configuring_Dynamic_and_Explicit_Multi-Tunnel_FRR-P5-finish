hostname P5
!
service routing protocols model multi-agent
!
interface Ethernet1
   no switchport
   ip address 172.16.15.5/24
   isis enable isis
   isis network point-to-point
   traffic-engineering
   traffic-engineering bandwidth 75 percent
   no shutdown
!
interface Ethernet2
   no switchport
   ip address 172.16.56.5/24
   isis enable isis
   isis network point-to-point
   traffic-engineering
   traffic-engineering bandwidth 75 percent
   no shutdown
!
interface Loopback0
   ip address 192.168.100.5/32
   isis enable isis
!
ip routing
!
ip prefix-list ldp-fec-prefix-list
   seq 10 permit 192.168.100.0/24 eq 32
!
mpls ip
!
mpls ldp
   router-id interface Loopback0
   fec filter prefix-list ldp-fec-prefix-list
   no shutdown
!
mpls rsvp
   fast-reroute mode node-protection
   no shutdown
!
router traffic-engineering
   router-id ipv4 192.168.100.5
!
router isis isis
   net 49.0000.0000.0000.0005.00
   router-id ipv4 192.168.100.5
   is-type level-1
   !
   address-family ipv4 unicast
      traffic-engineering
         no shutdown
!
