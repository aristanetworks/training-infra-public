hostname PE1
!
ip routing
!
service routing protocols model multi-agent
!
router isis isis
net 49.0000.0000.0000.0001.00
router-id ipv4 192.168.100.1
is-type level-1
!
address-family ipv4 unicast
segment-routing mpls
!
interface Loopback0
ip address 192.168.100.1/32
isis enable isis
node-segment ipv4 index 1
!
interface Ethernet1
no switchport
ip address 192.168.11.1/30
mtu 1500
no shutdown
!
interface Ethernet2
no switchport
ip address 192.168.21.1/30
mtu 1500
no shutdown
!
interface Ethernet3
no switchport
no ip address
no shutdown
!
interface Ethernet4
no switchport
ip address 172.16.13.1/24
mtu 1500
isis enable isis
isis network point-to-point
no shutdown
!
interface Ethernet5
no switchport
ip address 172.16.14.1/24
mtu 1500
isis enable isis
isis network point-to-point
no shutdown
!
interface Ethernet6
no switchport
ip address 172.16.15.1/24
mtu 1500
isis enable isis
isis network point-to-point
no shutdown
!
ip prefix-list ldp-fec-prefix-list
permit 192.168.100.0/24 ge 24
!
mpls ldp
router-id interface Loopback0 force
fec filter prefix-list ldp-fec-prefix-list
no shutdown
