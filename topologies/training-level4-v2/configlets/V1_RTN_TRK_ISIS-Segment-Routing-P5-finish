hostname P5
!
ip routing
!
interface Ethernet1
   no switchport
   ip address 172.16.15.5/24
   isis enable isis
   isis network point-to-point
!
interface Ethernet2
   no switchport
   ip address 172.16.56.5/24
   isis enable isis
   isis network point-to-point
!
interface Loopback0
   ip address 192.168.100.5/32
   isis enable isis
   node-segment ipv4 index 5
!
router isis isis
   net 49.0000.0000.0000.0005.00
   router-id ipv4 192.168.100.5
   is-type level-1
   address-family ipv4 unicast
   segment-routing mpls
      router-id 192.168.100.5
      no shutdown
!
mpls ip
!
