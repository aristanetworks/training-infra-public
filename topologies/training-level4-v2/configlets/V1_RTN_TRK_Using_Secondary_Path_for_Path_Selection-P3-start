hostname P3
!
interface Ethernet1
   mtu 1500
   no switchport
   ip address 172.16.13.3/24
   isis enable isis
   isis network point-to-point
   traffic-engineering
   traffic-engineering bandwidth 75 percent
!
interface Ethernet2
   mtu 1500
   no switchport
   ip address 172.16.23.3/24
   isis enable isis
   isis network point-to-point
   traffic-engineering
   traffic-engineering bandwidth 75 percent
!
interface Loopback0
   ip address 192.168.100.3/32
   isis enable isis
!
ip routing
!
ip prefix-list ldp-fec-prefix-list
   seq 10 permit 192.168.100.0/24 ge 24
!
mpls ip
!
mpls ldp
   router-id interface Loopback0
   fec filter prefix-list ldp-fec-prefix-list
   no shutdown
!
router traffic-engineering
   router-id ipv4 192.168.100.3
!
router isis isis
   net 49.0000.0000.0000.0003.00
   router-id ipv4 192.168.100.3
   is-type level-1
   !
   address-family ipv4 unicast
   !
   traffic-engineering
      no shutdown
      is-type level-1
!
mpls rsvp
   fast-reroute mode node-protection
   no shutdown

