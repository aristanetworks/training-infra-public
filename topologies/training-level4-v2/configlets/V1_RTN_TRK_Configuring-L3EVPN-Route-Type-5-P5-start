hostname P5
!
ip routing
mpls ip
!
service routing protocols model multi-agent
!
router isis isis
   net 49.0000.0000.0000.0005.00
   router-id ipv4 192.168.100.5
   is-type level-1
   segment-routing mpls srgb 900000 900000
   address-family ipv4 unicast
      segment-routing mpls
         no shutdown
!
interface Loopback0
   ip address 192.168.100.5/32
   isis enable isis
   node-segment ipv4 index 5
!
interface Ethernet1
   no switchport
   ip address 172.16.15.5/24
   mtu 1500
   isis enable isis
   isis network point-to-point
   no shutdown
!
interface Ethernet2
   no switchport
   ip address 172.16.56.5/24
   mtu 1500
   isis enable isis
   isis network point-to-point
   no shutdown
!