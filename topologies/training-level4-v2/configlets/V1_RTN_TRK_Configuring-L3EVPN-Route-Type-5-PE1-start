hostname PE1
!
ip routing
mpls ip
!
service routing protocols model multi-agent
!
router isis isis
   net 49.0000.0000.0000.0001.00
   router-id ipv4 192.168.100.1
   is-type level-1
   segment-routing mpls srgb 900000 900000
   address-family ipv4 unicast
      segment-routing mpls
         no shutdown
!
interface Loopback0
   ip address 192.168.100.1/32
   isis enable isis
   node-segment ipv4 index 1
!
interface Ethernet1
   no switchport
   ip address 192.168.11.1/30
   mtu 1500
   no shutdown
!
interface Ethernet2
   no switchport
   ip address 192.168.21.1/30
   mtu 1500
   no shutdown
!
interface Ethernet4
   no switchport
   ip address 172.16.13.1/24
   mtu 1500
   isis enable isis
   isis network point-to-point
   no shutdown
!
interface Ethernet5
   no switchport
   ip address 172.16.14.1/24
   mtu 1500
   isis enable isis
   isis network point-to-point
   no shutdown
!
interface Ethernet6
   no switchport
   ip address 172.16.15.1/24
   mtu 1500
   isis enable isis
   isis network point-to-point
   no shutdown
!
router bgp 65100
   no bgp default ipv4-unicast
   neighbor 192.168.100.2 remote-as 65100
   neighbor 192.168.100.2 next-hop-self
   neighbor 192.168.100.2 update-source Loopback0
   neighbor 192.168.100.2 send-community extended
   !
   address-family evpn
      neighbor default encapsulation mpls
      neighbor 192.168.100.2 activate
!