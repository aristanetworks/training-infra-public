hostname P5
   !
   ip routing
   !
   mpls ip
   !
   ip prefix-list ldp-fec-prefix-list
      seq 10 permit 192.168.100.0/24 ge 24
   !
   mpls ldp
      router-id interface Loopback0
      fec filter prefix-list ldp-fec-prefix-list
      no shutdown
   !
   interface Ethernet1
      no switchport
      ip address 172.16.15.5/24
      isis enable isis
      isis network point-to-point
   !
   interface Ethernet2
      no switchport
      ip address 172.16.56.5/24
      isis enable isis
      isis network point-to-point
   !
   interface Loopback0
      ip address 192.168.100.5/32
      isis enable isis
   !
   router isis isis
      net 49.0000.0000.0000.0005.00
      router-id ipv4 192.168.100.5
      is-type level-1
      address-family ipv4 unicast
   !