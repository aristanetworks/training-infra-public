hostname PE1
!
service routing protocols model multi-agent
!
ip routing
mpls ip
!
router traffic-engineering
   router-id ipv4 192.168.100.1
!
router isis isis
   net 49.0000.0000.0000.0001.00
   router-id ipv4 192.168.100.1
   is-type level-1
   !
   address-family ipv4 unicast
      segment-routing mpls
         no shutdown
!
interface Loopback0
   ip address 192.168.100.1/32
   isis enable isis
   node-segment ipv4 index 1
!
interface Ethernet1
   no switchport
   ip address 192.168.11.1/30
   no shutdown
!
interface Ethernet2
   no switchport
   ip address 192.168.21.1/30
   no shutdown
!
interface Ethernet3
   no switchport
   ip address 192.168.31.1/30
   no shutdown
!
interface Ethernet4
   no switchport
   ip address 172.16.13.1/24
   isis enable isis
   isis network point-to-point
   no shutdown
!
interface Ethernet5
   no switchport
   ip address 172.16.14.1/24
   isis enable isis
   isis network point-to-point
   no shutdown
!
interface Ethernet6
   no switchport
   ip address 172.16.15.1/24
   isis enable isis
   isis network point-to-point
   no shutdown
!
