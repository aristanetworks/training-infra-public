hostname P5
!
ip routing
mpls ip
!
service routing protocols model multi-agent
!
ip prefix-list ldp-fec-prefix-list
   permit 192.168.100.0/24 ge 32
!
router isis isis
   net 49.0000.0000.0000.0005.00
   router-id ipv4 192.168.100.5
   is-type level-1
   address-family ipv4 unicast
   segment-routing mpls
      no shutdown
!
interface Loopback0
   ip address 192.168.100.5/32
   isis enable isis
   node-segment ipv4 index 5
!
interface Ethernet1
   no switchport
   description to PE1
   ip address 172.16.15.5/24
   isis enable isis
   isis network point-to-point
   no shutdown
!
interface Ethernet2
   no switchport
   description to P6
   ip address 172.16.56.5/24
   isis enable isis
   isis network point-to-point
   no shutdown
!
mpls ldp
   router-id interface loopback 0
   fec filter prefix-list ldp-fec-prefix-list
   no shutdown
!
