   hostname P4
   !
   service routing protocols model multi-agent
   !
   ip routing
   mpls ip
   !
   ip prefix-list ldp-fec-prefix-list
      seq 10 permit 192.168.100.0/24 eq 32
   !
   mpls ldp
      router-id interface Loopback0
      fec filter prefix-list ldp-fec-prefix-list
      no shutdown
   !
   mpls rsvp
      fast-reroute mode node-protection
      no shutdown
   !
   router isis isis
      net 49.0000.0000.0000.0004.00
      router-id ipv4 192.168.100.4
      is-type level-1
      address-family ipv4 unicast
      traffic-engineering
      no shutdown
   !
   router traffic-engineering
   router-id ipv4 192.168.100.4
   administrative-group alias blue group 1
   administrative-group alias red group 2
   !
   rsvp
      local-interface Loopback0
   !
   interface Loopback0
      ip address 192.168.100.4/32
      isis enable isis
      no shutdown
   !
   interface Ethernet1
   no switchport
   ip address 172.16.14.4/24
   isis enable isis
   isis network point-to-point
   traffic-engineering
   traffic-engineering bandwidth 75 percent
   traffic-engineering administrative-group blue
   no shutdown
!
interface Ethernet2
   no switchport
   ip address 172.16.24.4/24
   isis enable isis
   isis network point-to-point
   traffic-engineering
   traffic-engineering bandwidth 75 percent
   traffic-engineering administrative-group red
   no shutdown
!
interface Ethernet3
   no switchport
   ip address 172.16.46.4/24
   isis enable isis
   isis network point-to-point
   traffic-engineering
   traffic-engineering bandwidth 75 percent
   traffic-engineering administrative-group red
   no shutdown
!