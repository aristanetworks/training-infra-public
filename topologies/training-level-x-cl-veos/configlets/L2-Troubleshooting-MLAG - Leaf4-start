hostname leaf4
!
vlan 30
   name HOST3
!
vlan 40
   name HOST4
!
vlan 4094
   name MLAG
   trunk group MLAGVLAN
!
spanning-tree mode mstp
no spanning-tree vlan-id 4094
!
ip virtual-router mac-address 001c.7300.0097
!
interface Ethernet1
   description MLAG Peer Link Member
   channel-group 200 mode active
   no shutdown
!
interface Ethernet2
   description MLAG Peer Link Member
   channel-group 200 mode active
   no shutdown
!
interface Ethernet3
   channel-group 40 mode active
   no shutdown
!
interface Ethernet4
   channel-group 40 mode active
   no shutdown
!
interface Ethernet7
   description LACP Connection to Host 3
   channel-group 1 mode active
   no shutdown
!
interface Ethernet9
   description LACP Connection to Host 4
   channel-group 2 mode active
   no shutdown
!
interface Port-Channel1
   description MLAG Connection to Host3
   switchport
   switchport access vlan 30
   mlag 1
   no shutdown
!
interface Port-Channel2
   description MLAG Connection to Host4
   switchport
   switchport access vlan 40
   mlag 2
   no shutdown
!
interface Port-Channel40
   description Leaf 3 and Leaf 4 MLAG PortChannel 40 to Spine MLAG
   switchport
   switchport mode trunk
   switchport trunk allowed vlan 30,40
   mlag 40
   no shutdown
!
interface Port-Channel200
   description MLAG Peer Link
   switchport
   switchport mode trunk
   switchport trunk group MLAGVLAN
   no shutdown
!
interface Vlan4094
   description MLAG Peer SVI
   ip address 172.16.50.2/30
   no autostate
!
mlag configuration
   domain-id MLAGLeaf3Leaf4
   heartbeat-interval 2500
   local-interface Vlan4094
   peer-address 172.16.50.1
   primary-priority 20
   peer-link Port-Channel200
!