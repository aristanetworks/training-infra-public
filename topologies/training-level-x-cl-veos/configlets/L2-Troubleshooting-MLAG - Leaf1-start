hostname leaf1
!
vlan 10
   name HOST1
!
vlan 20
   name HOST2
!
vlan 4094
   name MLAG
   trunk group MLAGVLAN
!
spanning-tree mode mstp
!
ip virtual-router mac-address 001c.7300.0098
!
interface Ethernet1
   description MLAG Peer Link Member
   channel-group 200 mode active
   no shutdown
!
interface Ethernet2
   description MLAG Peer Link Member
   channel-group 200 mode active
   no shutdown
!
interface Ethernet3
   channel-group 20 mode active
   no shutdown
!
interface Ethernet4
   channel-group 20 mode active
   no shutdown
!
interface Ethernet7
   description LACP Connection to Host 1
   channel-group 1 mode active
   no shutdown
!
interface Ethernet9
   description LACP Connection to Host 2
   channel-group 2 mode active
   no shutdown
!
interface Port-Channel1
   description MLAG Connection to Host1
   switchport
   switchport access vlan 10
   mlag 1
   no shutdown
!
interface Port-Channel2
   description MLAG Connection to Host2
   switchport
   switchport access vlan 20
   mlag 2
   no shutdown
!
interface Port-Channel20
   description Leaf 1 and Leaf 2 MLAG PortChannel 20 to Spine MLAG
   switchport
   switchport mode trunk
   switchport trunk allowed vlan 10,20
   mlag 20
   no shutdown
!
interface Port-Channel200
   description MLAG Peer Link
   switchport
   switchport mode trunk
   switchport trunk group MLAGVLAN
   no shutdown
!
interface Vlan4094
   description MLAG Peer SVI
   ip address 172.16.40.1/24
   no autostate
!
mlag configuration
   domain-id MLAGLeaf1
   heartbeat-interval 2500
   local-interface Vlan4094
   peer-address 172.16.40.2
   primary-priority 10
   peer-link Port-Channel200
!