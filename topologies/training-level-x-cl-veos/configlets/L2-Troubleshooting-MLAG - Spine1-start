hostname spine1
!
vlan 10
   name HOST1
!
vlan 20
   name HOST2
!
vlan 30
   name HOST3
!
vlan 40
   name HOST4
!
vlan 4094
   name MLAG
   trunk group MLAGVLAN
!
spanning-tree mode mstp
spanning-tree mst 0 root primary
no spanning-tree vlan-id 4094
!
ip routing
!
ip virtual-router mac-address 001c.7300.0099
!
interface Ethernet1
   description MLAG Peer Link Member
   channel-group 200 mode active
   no shutdown
!
interface Ethernet2
   description MLAG Peer Link Member
   channel-group 200 mode active
   no shutdown
!
interface Ethernet3
   channel-group 10 mode active
   no shutdown
!
interface Ethernet4
   channel-group 10 mode active
   no shutdown
!
interface Ethernet5
   channel-group 30 mode active
   no shutdown
!
interface Ethernet6
   channel-group 30 mode active
   no shutdown
!
interface Ethernet7
   shutdown
!
interface Ethernet8
   shutdown
!
interface Port-Channel10
   description Spine 1 and Spine 2 MLAG PortChannel 10 to Leaf 1 and Leaf 2 MLAG
   switchport
   switchport mode trunk
   switchport trunk allowed vlan 10,20
   mlag 10
   no shutdown
!
interface Port-Channel30
   description Spine 1 and Spine 2 MLAG PortChannel 30 to Leaf 3 and Leaf 4 MLAG
   switchport
   switchport mode trunk
   switchport trunk allowed vlan 30,40
   mlag 30
   no shutdown
!
interface Port-Channel200
   description MLAG Peer Link
   switchport
   switchport mode trunk
   switchport trunk group MLAGVLAN
   no shutdown
!
interface Vlan10
   ip address 192.168.10.1/24
   ip virtual-router address 192.168.10.254
   no autostate
!
interface Vlan20
   ip address 192.168.20.1/24
   ip virtual-router address 192.168.20.254
   no autostate
!
interface Vlan30
   ip address 192.168.30.1/24
   ip virtual-router address 192.168.30.254
   no autostate
!
interface Vlan40
   ip address 192.168.40.1/24
   ip virtual-router address 192.168.40.254
   no autostate
!
interface Vlan4094
   description MLAG Peer SVI
   ip address 172.16.30.1/30
   no autostate
!
mlag configuration
   domain-id MLAGSpine1Spine2
   local-interface Vlan4094
   peer-address 172.16.30.2
   peer-link Port-Channel200
   primary-priority 10
!