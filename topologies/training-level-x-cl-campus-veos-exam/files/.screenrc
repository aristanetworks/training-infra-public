# Turn off the startup message.
startup_message off
# Set the caption to the active windows.
caption always "%-Lw%{= BW}%50>%n%f* %t%{-}%+Lw%<"

term screen-256color

# New screens for various processes.
# Example: screen -t <hostname> <screen number> <command>
# screen -t 7050SX-128 0 ssh aristaadmin@192.100.37.128
screen 1 ssh 192.168.0.4
screen -t CVP 2 ssh 192.168.0.5
screen -t Spine1 3 ssh 192.168.0.11
screen -t Spine2 4 ssh 192.168.0.12
screen -t Spine3 5 ssh 192.168.0.13
screen -t Spine4 6 ssh 192.168.1.14
screen -t Leaf1 7 ssh 192.168.0.21
screen -t Leaf2 8 ssh 192.168.0.22
screen -t Leaf3 9 ssh 192.168.0.23
screen -t Leaf4 10 ssh 192.168.0.24
screen -t Leaf5 11 ssh 192.168.0.25
screen -t Host1 12 ssh 192.168.0.51
screen -t Host2 13 ssh 192.168.0.52
screen -t Host3 14 ssh 192.168.0.53
screen -t Host4 15 ssh 192.168.0.54
screen -t Host5 16 ssh 192.168.0.64
screen -t memleaf1 17 ssh 192.168.0.26
screen -t memleaf2 18 ssh 192.168.0.27

