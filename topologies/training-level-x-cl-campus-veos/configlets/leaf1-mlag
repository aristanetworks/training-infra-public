spanning-tree mode mstp
no spanning-tree vlan-id 4094
!

vlan 10
   name VLAN10
!
vlan 20
   name VLAN20
!
vlan 4094
   name MLAG_PEER
   trunk group MLAG
!

!
interface Port-Channel1
   description MLAG_PEER_leaf2_Po1
   switchport mode trunk
   switchport trunk group MLAG
!
interface Port-Channel4
   description SPINE1_Po3
   switchport trunk allowed vlan 10,20
   switchport mode trunk
   mlag 4
!
interface Ethernet1
   description MLAG_leaf2_Ethernet1
   channel-group 1 mode active
!
interface Ethernet2
   description MLAG_leaf2_Ethernet2
   channel-group 1 mode active
!
interface Ethernet3
   description VLAN 10 Access Port to Host1
   switchport access vlan 10
   spanning-tree portfast
   spanning-tree bpduguard enable
!
interface Ethernet4
   description TO_SPINE1_Ethernet3
   channel-group 4 mode active
!
interface Ethernet5
   description TO_SPINE2_Ethernet3
   channel-group 4 mode active
!

!
interface Vlan4094
   description MLAG_PEER
   mtu 1500
   no autostate
   ip address 169.254.0.0/31
!
ip routing
!
!
mlag configuration
   domain-id MLAG
   local-interface Vlan4094
   peer-address 169.254.0.1
   peer-link Port-Channel1
   reload-delay mlag 300
   reload-delay non-mlag 330